# LLM (OpenAI-compatible), тот же провайдер, что в Ankyra.
SKEIN_API_URL=https://routerai.ru/api/v1
SKEIN_API_KEY=
SKEIN_MODEL=~deepseek/deepseek-v4-flash-latest
SKEIN_TEMPERATURE=0.1
SKEIN_MAX_TOKENS=4096
# Размышления выключены: DeepSeek thinking + RouterAI reasoning budget.
SKEIN_REASONING_EFFORT=none

# Цикл
SKEIN_MAX_TURNS=24
SKEIN_LIVE=false

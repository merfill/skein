# Legacy env configuration. The preferred path is `skein auth login`, which writes
# ~/.config/skein/config.json and ~/.local/share/skein/auth.json (0600).
# Precedence: CLI > env > config > preset default.

# LLM (OpenAI-compatible)
SKEIN_PROVIDER=routerai
SKEIN_API_URL=https://routerai.ru/api/v1
SKEIN_API_KEY=
SKEIN_MODEL=~deepseek/deepseek-v4-flash-latest
SKEIN_TEMPERATURE=0.1
SKEIN_MAX_TOKENS=8192
SKEIN_MAX_TOKENS_CEILING=32768
SKEIN_MAX_TOKENS_BUMPS=2
SKEIN_LLM_RETRIES=2
SKEIN_REASONING_EFFORT=low
SKEIN_REASONING_TAPE=true
SKEIN_STREAMING=true

# Loop
SKEIN_MAX_TURNS=80
SKEIN_GENERAL_MAX_TURNS=9
SKEIN_STATE_CYCLE_ENTRIES=3
SKEIN_STATE_LONG_TURNS=9
SKEIN_BUDGET_TURNS=3
SKEIN_GRACE_TURNS=5
SKEIN_OBSERVER=false
SKEIN_RUN_TIMEOUT_MS=120000
SKEIN_LIVE=false

# JSONL session log: 1/true = .skein/session.log, a path = custom, off/false = disabled.
SKEIN_LOG=1
